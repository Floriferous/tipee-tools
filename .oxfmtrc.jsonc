{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  // Keep repository formatting explicit and stable.
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "printWidth": 100,
  "sortImports": true,
  "sortPackageJson": {
    "sortScripts": true,
  },
  // Generated files; oxfmt already skips node_modules and what git ignores.
  "ignorePatterns": ["plugins/tipee/server/**", "packages/*/src/generated/**"],
}
