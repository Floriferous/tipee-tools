# Copy this file to .env (same folder) to run the server from source with
# `pnpm mcp`. The .env file is ignored by git. Plugin users never need this:
# Claude Code asks for the values when it enables the plugin.

# The Tipee subdomain: "acme" if you sign in at acme.tipee.net.
TIPEE_INSTANCE=

# API key of an integration created in the Tipee admin panel (treat it like a password).
TIPEE_API_KEY=
