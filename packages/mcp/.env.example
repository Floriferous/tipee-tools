# Copy this file to .env (same folder) to run the server from source with
# `pnpm mcp`. The .env file is ignored by git. Users never need this: Claude
# Code asks for the values when it enables the plugin (its userConfig), and
# Claude Desktop in the extension's settings (the manifest's user_config).

# The Tipee subdomain: "acme" if you sign in at acme.tipee.net.
TIPEE_INSTANCE=

# API key of an integration created in the Tipee admin panel (treat it like a password).
TIPEE_API_KEY=
