{
  "name": "tipee-tools",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Floriferous/tipee-tools.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:check": "turbo run generate build && git diff --exit-code -- packages/core/src/generated plugins/tipee/server || (echo \"generated files are stale: run pnpm fix and commit\" && exit 1)",
    "check": "turbo run check",
    "fix": "turbo run generate && pnpm lint && pnpm format && turbo run build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "generate": "turbo run generate",
    "lint": "oxlint --type-aware --deny-warnings --fix -c oxlint.config.ts packages plugins oxlint.config.ts",
    "lint:check": "oxlint --type-aware --deny-warnings -c oxlint.config.ts packages plugins oxlint.config.ts",
    "mcp": "pnpm --filter @tipee-tools/mcp start",
    "pack": "turbo run pack",
    "plugin:validate": "claude plugin validate ./plugins/tipee --strict && claude plugin validate . --strict",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "spec:refresh": "node packages/core/scripts/refresh.ts",
    "test": "turbo run test",
    "verify": "turbo run generate lint:check format:check check test build pack --continue && pnpm build:check"
  },
  "devDependencies": {
    "@effect/tsgo": "0.56.0",
    "lefthook": "2.2.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "turbo": "2.11.7",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c"
}
