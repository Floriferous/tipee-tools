{
  "name": "tipee-tools",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Floriferous/tipee-tools.git"
  },
  "type": "module",
  "scripts": {
    "build": "turbo run build",
    "build:check": "turbo run generate build && git diff --exit-code -- packages/core/src/generated plugins/tipee/server || (echo \"generated files are stale: run pnpm fix and commit\" && exit 1)",
    "check": "turbo run check",
    "fix": "turbo run generate && pnpm lint && pnpm format && turbo run build",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "generate": "turbo run generate",
    "lint": "oxlint --type-aware --deny-warnings --fix -c oxlint.config.ts packages plugins oxlint.config.ts",
    "lint:check": "oxlint --type-aware --deny-warnings -c oxlint.config.ts packages plugins oxlint.config.ts",
    "mcp": "pnpm --filter @tipee-tools/mcp start",
    "pack": "turbo run pack",
    "plugin:validate": "claude plugin validate ./plugins/tipee --strict && claude plugin validate . --strict",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "spec:refresh": "node packages/core/scripts/refresh.ts",
    "test": "turbo run test",
    "verify": "turbo run generate lint:check format:check check test build pack --continue && pnpm build:check && node plugins/tipee/scripts/smoke.ts"
  },
  "devDependencies": {
    "@effect/tsgo": "0.67.5",
    "lefthook": "2.2.1",
    "oxfmt": "0.78.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.17.0+sha512.b8d223ebec04b580a89ed206daa71d1bccb6a1ee1d52efa95cc3b0db75271561df8f0d8e2c43add39c5ec08018af7a8a95108e7090f95a29f88727b7a40fd53d"
}
