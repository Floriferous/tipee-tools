{
  "$schema": "https://turborepo.dev/schema.json",
  "agentGuidance": false,
  "tasks": {
    "//#format:check": {
      "inputs": [
        ".oxfmtrc.jsonc",
        "*.{json,jsonc,md,ts,yml,yaml}",
        ".github/**",
        ".vscode/**",
        ".claude-plugin/**",
        ".claude/skills/**",
        "packages/**",
        "plugins/**",
        "!plugins/*/server/**",
        "!packages/*/src/generated/**"
      ]
    },
    "//#lint:check": {
      "inputs": [
        "oxlint.config.ts",
        "pnpm-lock.yaml",
        "packages/**",
        "plugins/**",
        "!plugins/*/server/**",
        "!**/*.md",
        "!packages/*/src/generated/**"
      ]
    },
    "build": {
      "dependsOn": ["transit"],
      "outputs": ["server/**"]
    },
    "check": {
      "dependsOn": ["transit"]
    },
    "test": {
      "dependsOn": ["transit"]
    },
    "transit": {
      "dependsOn": ["^transit", "generate"]
    },
    "pack": {
      "dependsOn": ["build"],
      "outputs": ["dist/**"]
    },
    "generate": {
      "inputs": ["spec/**", "scripts/**", "package.json"],
      "outputs": ["src/generated/**"]
    }
  }
}
